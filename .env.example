# ============================================================
# OmniFingerprint AdManager 环境变量模板
# 复制为 .env.local（开发）或 .env.production（生产构建）并填入真实值。
# 切勿将填入真实值的文件提交进仓库。
# ============================================================

# ---- 前端（构建时注入，Vite）----
# 本地 PUP 服务器鉴权密钥：前端请求本地 9999 服务时放在 X-Api-Secret 头
VITE_LOCAL_SERVER_SECRET=
# 私有收信域名（临时邮箱系统使用，如 mail.your-domain.example）
VITE_MAIL_DOMAIN=
# 本地 PUP 服务器地址（默认 http://localhost:9999）
# VITE_LAUNCH_SERVER_URL=http://localhost:9999
# 存储后端地址（默认同源 /api）
# VITE_STORAGE_SERVER_URL=

# ---- Adpos 直连凭据（可选，见 .env.production.example）----
# VITE_ADPOS_EMAIL=
# VITE_ADPOS_PASSWORD=
# VITE_ADPOS_TOKEN=

# ---- 本地 PUP Server（server/ 目录，运行时读取）----
PUPPETEER_PORT=9999
PUPPETEER_API_SECRET=
# 存储后端（云端）地址，本地服务同步数据用
STORAGE_SERVER_URL=
# 私有收信域名（服务端生成邮箱时使用）
MAIL_DOMAIN=
# 借用型浏览器空闲回收时间（毫秒）
# BORROWED_IDLE_MS=180000
# 浏览器实例总数限制（不设则不限制）
# MAX_ALIVE_BROWSERS=
