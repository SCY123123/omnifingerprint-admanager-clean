# ============================================================
# baota-backend（云端存储后端）环境变量模板
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# ============================================================

# ---- 数据库（MySQL / MariaDB）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_POOL_LIMIT=10

# ---- 服务 ----
# 监听端口（外网一般由 Nginx 反代到该端口）
PORT=7700
# API 鉴权密钥：本地 PUP Server / Email Worker 调用后端时使用，需与本地保持一致
PUPPETEER_API_SECRET=

# ---- AI（可选）----
DEEPSEEK_API_KEY=
GEMINI_WEB_URL=
GEMINI_WEB_KEY=
GEMINI_WEB_MODEL=

# ---- 商城（可选）----
SHOP_ADMIN_USER=
SHOP_ADMIN_PASS=
# 商城会话签名密钥（随机长字符串）
SHOP_TOKEN_SECRET=
